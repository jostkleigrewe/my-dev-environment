###> docker ###

DOCKER_PROJECT_NAME="name-of-the-app"
DOCKER_PROJECT_VERSION="1.0"
DOCKER_PROJECT_FOLDER=./

UID=1000
GID=1000

####> docker:VERSIONs ###
DOCKER_COMPOSER_VERSION=2
DOCKER_PHP_VERSION=8.5
DOCKER_PHP_IMAGE=php:8.5.2-fpm
###< docker:VERSIONs ###

####> docker:php ###
DOCKER_PHP_EXTENSIONS="pdo_mysql zip intl mbstring sockets opcache bcmath xsl redis xdebug"
####> docker:php ###

####> docker:nginx ###
DOCKER_NGINX_HOST="ai-eurip-com.docker.localhost"
####> docker:nginx ###

####> dev ###
DOCKER_DEV_FOLDER="./vendor/jostkleigrewe/my-dev-environment/"
####< dev ###

####< docker ###
