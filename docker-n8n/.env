# ---- Basics
TZ=Europe/Berlin

# ---- n8n
N8N_HOST=ai.example.com
N8N_PROTOCOL=https
N8N_PORT=5678
N8N_ENCRYPTION_KEY=change-me-to-a-64-char-random
WEBHOOK_URL=https://ai.example.com/
GENERIC_TIMEZONE=Europe/Berlin

# DB (n8n)
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-now
POSTGRES_DB=n8n

# ---- AnythingLLM
ANYTHINGLLM_PORT=3001
ANYTHINGLLM_AUTH_TOKEN=change-me-36-chars

# ---- Ollama
OLLAMA_PORT=11434
# Kommagetrennte Origins, wenn du von Browser-Clients aus darauf willst
OLLAMA_ORIGINS=https://ai.example.com,https://*.example.com,http://localhost:5678
