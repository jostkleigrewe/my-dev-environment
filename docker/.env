###> docker:mercure ###
# DE: 2026-09-28 Hub auf Mercure 1.0 (dunglas/mercure:v1.0.2), Nutzer: arma-ai. NUR Dev-Platzhalter, nie ein Prod-Secret.
#     Beide Keys = MERCURE_JWT_SECRET des Projekts (HMAC). TRUSTED_ISSUERS = MERCURE_JWT_ISSUER des Projekts.
#     CORS_ORIGINS = explizite Origin-Liste (kein `*` — mit Cookie/JWT in 1.0 unzulässig).
#     EXTRA_DIRECTIVES = weitere Caddy-Direktiven (eigene Zeile im Mercure-Block).
#     Vorher standen hier `KEY:'…'`-Zeilen mit einem JWT als Key (0.x-Relikt).
# EN: Dev placeholders only. Keys must equal the project's MERCURE_JWT_SECRET, issuers its MERCURE_JWT_ISSUER.
DOCKER_MERCURE_PUBLISHER_JWT_KEY='!ChangeThisMercureHubJWTSecretKey!'
DOCKER_MERCURE_SUBSCRIBER_JWT_KEY='!ChangeThisMercureHubJWTSecretKey!'
DOCKER_MERCURE_TRUSTED_ISSUERS='http://arma-ai-eurip-com.docker.localhost'
DOCKER_MERCURE_CORS_ORIGINS='http://arma-ai-eurip-com.docker.localhost http://127.0.0.1:8000 http://localhost:8000'
DOCKER_MERCURE_COOKIE_NAME='mercure_access_token'
DOCKER_MERCURE_JWT_SECRET='fee2a702744714321765204fb78728020eeeac58f7cd11986b5ab1efb2a3baad'
DOCKER_MERCURE_EXTRA_DIRECTIVES=''
DOCKER_MERCURE_DATA_VOLUME="${DOCKER_PROJECT_NAME}-${DOCKER_PROJECT_VERSION}-mercure-data"
DOCKER_MERCURE_CONFIG_VOLUME="${DOCKER_PROJECT_NAME}-${DOCKER_PROJECT_VERSION}-mercure-config"
###< docker:mercure ###

